{
  "name": "japanese-master-ai-root",
  "version": "1.0.0",
  "private": true,
  "description": "Japanese Master AI - Fullstack Monorepo (React Frontend + Java Spring Boot Backend + PostgreSQL)",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "powershell -Command \"Set-Location backend; .\\mvnw.cmd spring-boot:run\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "powershell -Command \"Set-Location backend; .\\mvnw.cmd clean package -DskipTests\"",
    "build": "npm run build:frontend && npm run build:backend",
    "codegraph:status": "codegraph status",
    "codegraph:sync": "codegraph sync",
    "codegraph:index": "codegraph index"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
